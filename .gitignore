# --- Python ---
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / SvelteKit / Vite ---
frontend/node_modules/
frontend/.svelte-kit/
frontend/build/
frontend/.vite/

# --- Runtime data ---
data/
!data/.keep
# Static frontend assets — committed reference data (watershed
# outlines, reservoir markers) that ships with the build.
!frontend/static/data/
!frontend/static/data/**

# --- Local config / secrets ---
#
# Deliberately broad. The deployment docs instruct operators to create
# ops/.env and ops/.env.prod, which the previous `.env` / `.env.*.local`
# rules did NOT match — one `git add -A` would have put a Postgres password
# and an admin password into git history permanently, where removing them
# means rewriting history and rotating both.
#
# Ignore every env file anywhere, then re-admit the committed templates.
.env
.env.*
!.env.example
!.env.*.example

# --- Validation test artifacts (regenerable) ---
validation_tests/samples/
validation_tests/screenshots/
validation_tests/state/

# --- Editor / OS junk ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- MkDocs build output ---
site/

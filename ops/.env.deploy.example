# ─────────────────────────────────────────────────────────────────────────────
# Sentinel deployment configuration.
#
#   cp ops/.env.deploy.example ops/.env
#   $EDITOR ops/.env
#   bash ops/preflight.sh
#
# Used by: docker compose -f ops/docker-compose.deploy.yml --env-file ops/.env
#
# ops/.env holds secrets. It is gitignored — keep it that way, and note that
# `rsync --delete` to a server will wipe it unless you exclude it explicitly.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. REQUIRED ──────────────────────────────────────────────────────────────

# Postgres password. No default; the stack refuses to start without it.
# Generate one:  openssl rand -hex 32
POSTGRES_PASSWORD=

# The first admin account, created on first startup while the users table is
# empty. After that it is ignored — change the password in the UI, not here.
SENTINEL_ADMIN_EMAIL=
SENTINEL_ADMIN_PASSWORD=
SENTINEL_ADMIN_DISPLAY_NAME=


# ── 2. HOW PEOPLE REACH IT ───────────────────────────────────────────────────
#
# See ops/Caddyfile for the three supported shapes. Briefly:
#
#   LAN, no TLS       SENTINEL_SITE_ADDRESS=:80        <- works with no DNS
#                     SENTINEL_TLS_DIRECTIVE=
#
#   Internal + TLS    SENTINEL_SITE_ADDRESS=https://sentinel.lab.example.edu
#                     SENTINEL_TLS_DIRECTIVE=tls internal
#
#   Public + TLS      SENTINEL_SITE_ADDRESS=https://sentinel.example.edu
#                     SENTINEL_TLS_DIRECTIVE=tls ops@example.edu
#                     (needs public DNS here, and 80+443 reachable)
#
# Do NOT put a port here — see ops/Caddyfile. Caddy binds the port named in
# this address inside the container, while compose maps host ports to 80/443;
# a port here makes the site silently unreachable. Use HTTP_PORT below instead.
# The default `:80` matches any hostname or IP, so it works with no DNS.
SENTINEL_SITE_ADDRESS=:80
SENTINEL_TLS_DIRECTIVE=

# Host ports for the proxy. Change if something already owns 80/443.
HTTP_PORT=80
HTTPS_PORT=443

# Absolute URL embedded in alert emails ("Open in dashboard" and image links).
# Defaults to SENTINEL_SITE_ADDRESS, which is right unless the address people
# type differs from the one the proxy serves. Blank omits those links.
SENTINEL_PUBLIC_URL=

# NOTE: PUBLIC_SENTINEL_API_BASE is deliberately absent. It is baked in when
# the frontend IMAGE is built and cannot be changed by a pre-built image, so
# setting it here would do nothing. Behind the proxy the API is same-origin
# and it is not needed. Only relevant if you build your own frontend image
# and serve the API from a different origin.


# ── 3. WHAT IT MONITORS ──────────────────────────────────────────────────────

# The upstream being watched. Change this and Sentinel points somewhere else;
# see docs/06-porting-to-other-upstreams.md for what else has to change.
SENTINEL_BASE=https://radarca.engr.colostate.edu


# ── 4. RETENTION — read this one ─────────────────────────────────────────────
#
# Sentinel writes ~29,000 check rows a day plus archived images. Left
# unbounded it WILL fill the disk; that has already happened once on this
# project and took the stack down. The defaults below are sane, so the
# failure mode is only reachable by deliberately blanking them.

# Days of check_runs / metric_samples kept in Postgres. Older rows are
# exported to gzipped CSV under the cold volume, verified, then deleted.
SENTINEL_DB_RETENTION_DAYS=60

# UTC hour for the daily retention sweep. Pick a quiet hour.
SENTINEL_RETENTION_HOUR_UTC=9

# Days of archived L4 PNGs kept. BLANK MEANS FOREVER, which grows about
# 7 GB/month at radarca scale. Set a number unless the archive lives on
# storage you are confident is large enough.
SENTINEL_ARCHIVE_RETENTION_DAYS=


# ── 5. STORAGE LOCATIONS ─────────────────────────────────────────────────────
#
# Each takes EITHER the default managed-volume name shown below, OR an
# ABSOLUTE host path such as /mnt/bigdisk/sentinel/archive. It cannot take an
# arbitrary new volume name: compose only accepts names declared in the file,
# and anything else that is not an absolute path fails at startup with
# "refers to undefined volume".
#
# Use a host path to put the image archive on a large or network-mounted disk;
# it is by far the biggest consumer. Postgres data should stay on a LOCAL
# volume or path — network filesystems do not reliably provide the fsync and
# locking semantics it needs, and corruption there is not recoverable.
SENTINEL_ARCHIVE_PATH=sentinel_archive
SENTINEL_COLD_PATH=sentinel_cold
SENTINEL_PGDATA_PATH=sentinel_pgdata


# ── 6. IMAGES ────────────────────────────────────────────────────────────────

# Which published images to run. Pin a release tag for a stable deployment;
# `latest` tracks main and will change under you.
SENTINEL_TAG=latest

# GitHub owner the images are published under. Change if you fork the repo and
# publish your own — CI names them ghcr.io/<owner>/sentinel-{backend,frontend}.
SENTINEL_IMAGE_OWNER=jkmesches


# ── 7. OTHER ─────────────────────────────────────────────────────────────────

# DEBUG is very verbose. INFO is right for normal operation.
SENTINEL_LOG_LEVEL=INFO

# Postgres identity. Rarely worth changing.
POSTGRES_USER=sentinel
POSTGRES_DB=sentinel

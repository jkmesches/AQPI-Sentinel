# Sentinel production env. Copy to ops/.env.prod and fill in.
# Passed to docker compose via --env-file ops/.env.prod.

# --- Postgres ---
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=         # required — pick a strong one
POSTGRES_DB=sentinel

# --- Backend ---
SENTINEL_BASE=https://radarca.engr.colostate.edu
SENTINEL_LOG_LEVEL=INFO
# Blank = permanent retention for archived L4 images
SENTINEL_ARCHIVE_RETENTION_DAYS=

# --- Bootstrap admin (used on first startup with empty users table) ---
SENTINEL_ADMIN_EMAIL=
SENTINEL_ADMIN_PASSWORD=
SENTINEL_ADMIN_DISPLAY_NAME=

# --- Public-facing dashboard URL ---
# Embedded in alert emails (Open in dashboard button + image links) and in
# the daily report, where it builds the evidence link on every row.
# Leave blank to omit those links. Use the user-facing URL even if
# different from BACKEND_PORT — e.g. https://sentinel.example.com
SENTINEL_PUBLIC_URL=

# --- Retention (added v0.2.0) ---
# Days of check_runs / metric_samples kept in Postgres. Older rows are
# exported to gzipped CSV under the cold volume, verified, then deleted.
# Sentinel writes ~29,000 rows a day; leave this unset and the database grows
# without bound. The reference deployment filled its disk that way once.
SENTINEL_DB_RETENTION_DAYS=60
# UTC hour for the daily retention sweep. Pick a quiet hour, and keep it
# LATER than the backup cron so a backup always precedes the deletion.
SENTINEL_RETENTION_HOUR_UTC=9

# --- Storage locations (added v0.2.0) ---
# Either a declared volume name or an absolute host path. Use a host path to
# put the image archive on a large or network-mounted disk — it is by far the
# biggest consumer (~7 GB/month at radarca scale). Keep pgdata local:
# network filesystems do not reliably provide the fsync and locking
# semantics Postgres needs.
SENTINEL_ARCHIVE_HOST_PATH=sentinel_archive
SENTINEL_COLD_HOST_PATH=sentinel_cold

# Read-only mount of the directory ops/backup.sh writes to, so the
# layer0.self.backup check can read status.json and alarm when the nightly
# dump goes stale or starts failing. Set it to the SAME absolute path as the
# cron job's SENTINEL_BACKUP_DIR.
#
# Left as the volume name, the check reports "backup monitoring not
# configured" and stays silent — which is honest, but means a broken backup is
# discovered when you need one. That happened here: backups aborted for two
# days in September 2026 and nothing said so, because this was unset.
SENTINEL_BACKUP_HOST_PATH=sentinel_backups

# --- Which published images to run (ghcr compose only) ---
# Pin a release tag for a deployment that does not change under you;
# `latest` tracks main.
#
# NO leading `v`: the git tag is v0.2.0, the image tag is 0.2.0.
SENTINEL_TAG=latest

# --- Port mapping (the LAN-facing ports) ---
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Frontend ---
# Leave blank to let the browser resolve <hostname>:8000 automatically
# from window.location. Set this only if your backend is at a different
# origin than the host that serves the frontend (e.g. behind a proxy).
PUBLIC_SENTINEL_API_BASE=

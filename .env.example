# Sentinel dev environment.
# Copy to .env (gitignored) and fill in. Loaded by backend/main.py.

# Postgres
SENTINEL_DB_URL=postgresql://sentinel:sentinel-dev@127.0.0.1:5432/sentinel

# Upstream system under monitoring
SENTINEL_BASE=https://radarca.engr.colostate.edu

# Where to put images, screenshots, model files
SENTINEL_DATA_DIR=./data

# API server
SENTINEL_API_HOST=127.0.0.1
SENTINEL_API_PORT=8000

# Logging
SENTINEL_LOG_LEVEL=INFO

# Bootstrap admin — created on first startup if the users table is empty.
# Leave blank to skip (you can create users manually via SQL). Once at least
# one user exists these are ignored, so you can leave them filled in without
# worry of resetting your account.
SENTINEL_ADMIN_EMAIL=
SENTINEL_ADMIN_PASSWORD=
SENTINEL_ADMIN_DISPLAY_NAME=

# Image archive (data/archive/<sha[:2]>/<sha>.png)
# SENTINEL_ARCHIVE_ENABLED=1
# SENTINEL_ARCHIVE_ROOT=./data/archive
# SENTINEL_ARCHIVE_RETENTION_DAYS=    # blank = permanent
